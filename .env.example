# Copia a .env y rellena

# Modo: "dry" = sin APIs externas (todo simulado, guarda en data/*.json)
#       "live" = Firestore + Gemini + YouTube reales
MODE=dry

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# Firebase (ruta al JSON de service account)
FIREBASE_CREDENTIALS=./firebase-sa.json

# YouTube OAuth (de Google Cloud Console)
YOUTUBE_CLIENT_SECRETS=./client_secret.json
# Los tokens por canal se guardan en ./data/yt_token_<canal>.json

# Google Cloud TTS usa GOOGLE_APPLICATION_CREDENTIALS (puede ser el mismo SA de Firebase)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-sa.json

# Token simple para proteger los endpoints de ejecución
API_TOKEN=cambia-esto

# Carpeta donde dejas las partidas grabadas (canal gaming)
GAMING_INBOX=./media/gaming/inbox
